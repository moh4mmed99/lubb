[Unit]
Description=LUBB AI server (Whisper + the minutes LLM, port 8001)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
WorkingDirectory=%h/lubb/ai
EnvironmentFile=%h/lubb/ai/.env
ExecStart=%h/lubb/ai/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
