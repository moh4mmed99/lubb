# Copy to backend/.env and start the hub with:  .venv/bin/uvicorn app.main:app --env-file .env --port 8000

# The AI PC (ai/server.py; README → Running the AI). Its name over Tailscale, or 127.0.0.1 on the AI PC itself.
# AI_TOKEN is the one in the AI PC's ai/.env.
STT_ENGINE=remote
STT_URL=http://ai-pc-name:8001
LLM_ENGINE=ollama
OLLAMA_URL=http://ai-pc-name:8001
LLM_MODEL=qwen2.5:14b
AI_TOKEN=paste-token-here

# Or Google Colab: colab/lubb_ai_colab.ipynb prints these values (https://xxxx.trycloudflare.com); they change
# every session.

# No AI at all (UI development):  STT_ENGINE=stub  LLM_ENGINE=stub

# Keep the audio of every turn (data/recordings/), to listen to meetings again from the archive. Off where
# recordings of what people said mustn't be kept.
RECORD_AUDIO=true

# USB mics plugged into this machine (e.g. through a USB hub) connect as buttons btn-1, btn-2, … in port order,
# started with the hub. Set to false when the real wireless buttons are used instead.
LOCAL_MICS=true
# The USB hub's own port number for socket 1, socket 2, … : the mic in socket N is always btn-N.
# Default 2,1,4,3 = the Unitek Y-3089, so leave it out for that hub. Another hub: plug one mic into each socket
# in turn and note the last number of its port in "scripts/mic_button.py --list". Empty = plain port order.
# MIC_SOCKETS=2,1,4,3
